[Unit]
Description=MOD-host
After=jack.service
BindsTo=jack.service

[Service]
LimitRTPRIO=95
LimitMEMLOCK=infinity
Type=forking
Environment=LV2_PATH=/home/pistomp/.mod/.lv2:/usr/lib/lv2:/usr/local/lib/lv2
Environment=MOD_DATA_DIR=/home/pistomp/.mod
ExecStart=/usr/local/bin/mod-host -p 5555 -f 5556
User=jack
Group=jack
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
